# Пример конфигурационного файла для poweroff-notify-daemon
# Размещается в /etc/poweroff.time

[default]
# Время выключения в формате HH:MM (24-часовой формат)
# ВАЖНО: В секции [default] значение 'none' НЕ допускается
shutdown_time = 18:00

# Дни недели когда выключение должно работать (1=Пн, 2=Вт, ..., 7=Вс)
# Можно указать несколько дней через запятую
# Если параметр не указан — работает каждый день (по умолчанию: 1,2,3,4,5,6,7)
# Примеры:
#   days = 1,2,3,4,5      # только рабочие дни (Пн-Пт)
#   days = 1,2,3,4,5,6    # Пн-Сб
#   days = 1,3,5          # только Пн, Ср, Пт
days = 1,2,3,4,5

# Количество минут для продления времени выключения
extend_minutes = 30

# За сколько минут до выключения показывать предупреждение
warn_minutes = 10

# Интервал перезагрузки конфигурации (в минутах)
reload_minutes = 15

# Интерактивный режим: true - systemd спросит подтверждение у активных сессий,
# false - принудительное выключение без запросов
interactive = true

# ============================================================================
# ПРИОРИТЕТЫ ПРАВИЛ:
# 1. [default] - базовые настройки для всех
# 2. [group:имягруппы] - настройки для доменных групп (переопределяют [default])
# 3. [user:username] - персональные настройки (переопределяют [group:*] и [default])
# ============================================================================

# Настройки для доменных групп
# Формат: [group:имягруппы]
# Имя группы без учёта регистра (night-users = Night-Users = NIGHT-USERS)

[group:night-users]
# Группа ночной смены - выключение в 23:00
shutdown_time = 23:00
extend_minutes = 60
warn_minutes = 15
# Работают только в пятницу
days = 5

[group:developers]
# Разработчики - продлённое время
shutdown_time = 20:00
extend_minutes = 60
warn_minutes = 5
days = 1,2,3,4,5

[group:always-worked-users]
# Группа с отключённым автовыключением
shutdown_time = none
# ВАЖНО: 'none' допускается в [group:*] и [user:*], но НЕ в [default]

# Персональные настройки пользователей (переопределяют [group:*] и [default])
# Формат: [user:username]

[user:ivanov.aa]
shutdown_time = 19:00
extend_minutes = 30
interactive = true
# Для этого пользователя работает Пн-Пт + Сб
days = 1,2,3,4,5,6

[user:petrov.aa]
# Если параметр не указан, берётся из [default]
interactive = false
warn_minutes = 5
# Только рабочие дни (Пн-Пт)
days = 1,2,3,4,5

[user:sidorov.bb]
shutdown_time = 17:30
extend_minutes = 15
# Только Пн, Ср, Пт
days = 1,3,5

# Пример отключения выключения для конкретного пользователя
# ВАЖНО: Значение 'none' допускается ТОЛЬКО в пользовательских секциях
[user:admin]
shutdown_time = none
# Для этого пользователя автоматическое выключение отключено
# В трее будет показано "Выкл. откл.", пункт "Продлить время" неактивен
